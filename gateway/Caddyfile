http://etlers.com, http://www.etlers.com, http://localhost, http://127.0.0.1 {
	@contact path /api/contact /api/contact/*
	reverse_proxy @contact contact-api:8001

	@medical_sql path /api/sql/run
	reverse_proxy @medical_sql {$MEDICAL_SQL_UPSTREAM_HOST}:{$MEDICAL_SQL_UPSTREAM_PORT}

	@ai_dw_legacy path_regexp ai_dw ^/ai-dw(/.*)?$
	redir @ai_dw_legacy https://aidw.etlers.com{re.ai_dw.1} 308

	redir /erd_preview.html /frontend/erd_preview.html 308

	@medical_erd path /frontend/erd_preview.html /docs/* /README.md
	handle @medical_erd {
		root * /srv/db_hospital
		file_server
	}

	reverse_proxy {$PORTAL_UPSTREAM_HOST}:{$PORTAL_UPSTREAM_PORT}
}

